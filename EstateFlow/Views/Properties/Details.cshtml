@model EstateFlow.Models.Property
@using EstateFlow.Services
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Детайли: " + Model.ReferenceNumber;
    var isFavorite = ViewData["IsFavorite"] is true;

    // Създаваме адрес за Google Maps от данните на имота.
    var mapQuery = PropertyLocation.MapQuery(Model);

    // Използваме API ключ само ако е конфигуриран.
    // Без ключ се използва неофициалният Google Maps embed URL.
    var mapsKey = Configuration["GoogleMaps:EmbedApiKey"];

    var embedUrl = mapQuery is not null
        ? PropertyLocation.MapEmbedUrl(mapQuery, mapsKey)
        : null;

    var mapsLink = mapQuery is not null
        ? PropertyLocation.MapLinkUrl(mapQuery)
        : null;
}

<div class="page-heading animate-in">
    <div><p class="eyebrow">Открий своето място</p><h1>@Html.DisplayFor(m => m.Type) в @Model.City</h1><p class="text-muted small mt-2 mb-0">@Model.Neighborhood · @Model.ReferenceNumber</p></div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="details-favorite-form" class="favorite-detail-form"
              asp-controller="Favorites" asp-action="Toggle" method="post"
              data-favorite-state="@(isFavorite ? "true" : "false")">
            <input type="hidden" name="propertyId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Properties", new { id = Model.Id })" />
            <button class="favorite-detail-button @(isFavorite ? "is-favorite" : "")" type="submit"
                    aria-pressed="@(isFavorite ? "true" : "false")"
                    aria-label="@(isFavorite ? "Премахни от любими" : "Добави в любими")"
                    title="@(isFavorite ? "Премахни от любими" : "Добави в любими")">
                <svg class="favorite-heart" viewBox="0 0 24 24" width="27" height="27" aria-hidden="true" focusable="false">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
                </svg>
                <span class="favorite-detail-copy">
                    <strong data-favorite-label>@(isFavorite ? "В любими" : "Запази в любими")</strong>
                    <small data-favorite-hint>@(isFavorite ? "Натисни, за да премахнеш" : "Натисни сърцето, за да запазиш")</small>
                </span>
            </button>
            <span id="favorite-detail-status" class="visually-hidden" role="status" aria-live="polite"></span>
        </form>
    }
    else
    {
        <a class="favorite-detail-button favorite-login-link" asp-controller="Account" asp-action="Login"
           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
           aria-label="Влез, за да запазиш имота в любими">
            <svg class="favorite-heart" viewBox="0 0 24 24" width="27" height="27" aria-hidden="true" focusable="false">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
            </svg>
            <span class="favorite-detail-copy"><strong>Запази в любими</strong><small>Влез в профила си</small></span>
        </a>
    }
</div>
<div class="detail-layout">
    <div>
        <img src="@PropertyImageService.DisplayPath(Model.ImagePath)" alt="Снимка на имот @Model.ReferenceNumber" class="detail-cover" data-property-photo />
        <section class="card detail-section"><div class="card-body"><h2>За имота</h2><p class="detail-description mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "Няма добавено описание." : Model.Description)</p></div></section>
        <section class="card detail-section"><div class="card-body"><h2>Локация</h2>
            <p class="text-muted small">@Model.City · @Model.Neighborhood @if (!string.IsNullOrWhiteSpace(Model.Street)) { <span>· @Model.Street</span> }</p>
            @if (embedUrl is not null)
            {
                <div class="ratio ratio-16x9 rounded overflow-hidden border"><iframe src="@embedUrl" title="Карта на имот @Model.ReferenceNumber" loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div>
                <div class="d-flex justify-content-between align-items-center gap-3 mt-3 flex-wrap"><small class="text-muted">Местоположението е определено по адреса и може да е приблизително.</small><a href="@mapsLink" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary">Отвори в Google Maps</a></div>
            }
            else
            { <p class="alert alert-info mb-0">Няма достатъчно информация за местоположението на този имот.</p> }
        </div></section>
    </div>
    <aside class="detail-aside">
        <section class="card"><div class="card-body"><p class="eyebrow">Твоят следващ адрес</p><div class="detail-price">@Model.Price.ToString("N0") €</div>
            <div class="detail-facts"><span>@Model.Area.ToString("N0") м²</span>@if (Model.Rooms.HasValue) { <span>@Model.Rooms стаи</span> }@if (Model.Floor.HasValue) { <span>Етаж @Model.Floor</span> }</div>
            <hr /><h2 class="h6 mt-4">Свържи се с брокера</h2><a class="contact-link" href="tel:@Model.ContactPhone">@Model.ContactPhone</a><a class="contact-link" href="mailto:@Model.ContactEmail">@Model.ContactEmail</a>
            <p class="text-muted small mt-3 mb-0">При запитване посочи реф. номер @Model.ReferenceNumber.</p>
        </div></section>
        <div class="d-flex gap-2 flex-wrap mt-3">
            @if (User.IsInRole("Admin") || (User.IsInRole("Broker") && Model.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Редакция</a><a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">Изтриване</a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Към обявите</a>
        </div>
    </aside>
</div>
@section Scripts {
    <script src="~/js/property-details-favorite.js" asp-append-version="true"></script>
}
