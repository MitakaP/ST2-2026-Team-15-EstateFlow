@model IReadOnlyList<EstateFlow.Models.Property>
@{ ViewData["Title"] = "Моите имоти"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Моите имоти</h1>
    <a asp-action="Create" class="btn btn-primary">+ Добави имот</a>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">Все още нямате добавени имоти.</div>
}
else
{
    <div class="table-responsive"><table class="table table-striped align-middle">
        <thead><tr><th>Реф. номер</th><th>Местоположение</th><th>Цена</th><th class="text-end">Действия</th></tr></thead>
        <tbody>
        @foreach (var property in Model)
        {
            <tr>
                <td>@property.ReferenceNumber</td>
                <td>@property.City, @property.Neighborhood</td>
                <td>@property.Price.ToString("N0") €</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@property.Id" class="btn btn-sm btn-outline-secondary">Детайли</a>
                    <a asp-action="Edit" asp-route-id="@property.Id" class="btn btn-sm btn-outline-primary">Редакция</a>
                    <a asp-action="Delete" asp-route-id="@property.Id" class="btn btn-sm btn-outline-danger">Изтрий</a>
                </td>
            </tr>
        }
        </tbody>
    </table></div>
}
