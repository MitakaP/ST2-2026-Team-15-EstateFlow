@model EstateFlow.Models.Property
@using EstateFlow.Services
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration

@{
    ViewData["Title"] = "Детайли: " + Model.ReferenceNumber;
    var isFavorite = ViewData["IsFavorite"] is true;

    // Създаваме адрес за Google Maps от данните на имота.
    var mapQuery = PropertyLocation.MapQuery(Model);

    // Използваме API ключ само ако е конфигуриран.
    // Без ключ се използва неофициалният Google Maps embed URL.
    var mapsKey = Configuration["GoogleMaps:EmbedApiKey"];

    var embedUrl = mapQuery is not null
        ? PropertyLocation.MapEmbedUrl(mapQuery, mapsKey)
        : null;

    var mapsLink = mapQuery is not null
        ? PropertyLocation.MapLinkUrl(mapQuery)
        : null;
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
    <div>
        <p class="text-uppercase text-muted small fw-semibold mb-1">EstateFlow · Детайли на имот</p>
        <h1 class="h3 mb-0">Обява: @Model.ReferenceNumber</h1>
    </div>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="details-favorite-form" class="favorite-detail-form"
              asp-controller="Favorites" asp-action="Toggle" method="post"
              data-favorite-state="@(isFavorite ? "true" : "false")">
            <input type="hidden" name="propertyId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@Url.Action("Details", "Properties", new { id = Model.Id })" />
            <button class="favorite-detail-button @(isFavorite ? "is-favorite" : "")" type="submit"
                    aria-pressed="@(isFavorite ? "true" : "false")"
                    aria-label="@(isFavorite ? "Премахни от любими" : "Добави в любими")"
                    title="@(isFavorite ? "Премахни от любими" : "Добави в любими")">
                <svg class="favorite-heart" viewBox="0 0 24 24" width="27" height="27" aria-hidden="true" focusable="false">
                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
                </svg>
                <span class="favorite-detail-copy">
                    <strong data-favorite-label>@(isFavorite ? "В любими" : "Запази в любими")</strong>
                    <small data-favorite-hint>@(isFavorite ? "Натисни, за да премахнеш" : "Натисни сърцето, за да запазиш")</small>
                </span>
            </button>
            <span id="favorite-detail-status" class="visually-hidden" role="status" aria-live="polite"></span>
        </form>
    }
    else
    {
        <a class="favorite-detail-button favorite-login-link" asp-controller="Account" asp-action="Login"
           asp-route-returnUrl="@Url.Action("Details", "Properties", new { id = Model.Id })"
           aria-label="Влез, за да запазиш имота в любими">
            <svg class="favorite-heart" viewBox="0 0 24 24" width="27" height="27" aria-hidden="true" focusable="false">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78Z" />
            </svg>
            <span class="favorite-detail-copy"><strong>Запази в любими</strong><small>Влез в профила си</small></span>
        </a>
    }
</div>

<div class="card shadow-sm">
    <div class="card-body">

        <!-- ОСНОВНА ИНФОРМАЦИЯ -->
        <h5 class="card-title text-primary mb-4">
            Основна информация
        </h5>

        <dl class="row mb-0">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(m => m.Type)
            </dt>
            <dd class="col-sm-9">
                @Html.DisplayFor(m => m.Type)
            </dd>

            <dt class="col-sm-3">Цена</dt>
            <dd class="col-sm-9 fw-bold text-success">
                @Model.Price.ToString("N0") €
            </dd>

            <dt class="col-sm-3">Площ</dt>
            <dd class="col-sm-9">
                @Model.Area кв.м.
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(m => m.Rooms)
            </dt>
            <dd class="col-sm-9">
                @(Model.Rooms?.ToString() ?? "—")
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(m => m.Floor)
            </dt>
            <dd class="col-sm-9">
                @(Model.Floor?.ToString() ?? "—")
            </dd>
        </dl>

        <hr />

        <!-- ЛОКАЦИЯ -->
        <h5 class="card-title text-primary mb-4">
            Локация
        </h5>

        <dl class="row mb-0">
            <dt class="col-sm-3">
                @Html.DisplayNameFor(m => m.City)
            </dt>
            <dd class="col-sm-9">
                @Model.City
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(m => m.Neighborhood)
            </dt>
            <dd class="col-sm-9">
                @Model.Neighborhood
            </dd>

            <dt class="col-sm-3">
                @Html.DisplayNameFor(m => m.Street)
            </dt>
            <dd class="col-sm-9">
                @(Model.Street ?? "—")
            </dd>
        </dl>

        <!-- GOOGLE MAPS -->
        <div class="mt-4">
            <h6 class="fw-semibold mb-3">
                <i class="bi bi-geo-alt-fill me-2"></i>
                Местоположение на картата
            </h6>

            @if (embedUrl is not null)
            {
                <div class="ratio ratio-16x9 rounded overflow-hidden border">
                    <iframe src="@embedUrl"
                            title="Карта на имот @Model.ReferenceNumber"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen>
                    </iframe>
                </div>

                <div class="d-flex justify-content-between
                            align-items-center gap-3 mt-3 flex-wrap">

                    <small class="text-muted">
                        Локацията е определена по въведения адрес
                        и може да е приблизителна.
                    </small>

                    <a href="@mapsLink"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i>
                        Отвори в Google Maps
                    </a>
                </div>
            }
            else
            {
                <div class="alert alert-light border" role="status">
                    <i class="bi bi-info-circle me-2"></i>
                    Няма достатъчно информация за
                    местоположението на този имот.
                </div>
            }
        </div>

        <hr />

        <!-- КОНТАКТИ С БРОКЕР -->
        <h5 class="card-title text-primary mb-4">
            Контакти с брокер
        </h5>

        <dl class="row mb-0">
            <dt class="col-sm-3">Телефон</dt>
            <dd class="col-sm-9">
                @Model.ContactPhone
            </dd>

            <dt class="col-sm-3">Имейл</dt>
            <dd class="col-sm-9">
                <a href="mailto:@Model.ContactEmail">
                    @Model.ContactEmail
                </a>
            </dd>
        </dl>

        <hr />

        <!-- ОПИСАНИЕ -->
        <h5 class="card-title text-primary mb-3">
            Описание
        </h5>

        <p class="text-muted" style="white-space: pre-wrap;">@(Model.Description ?? "Няма добавено описание.")</p>

    </div>

    <!-- БУТОНИ -->
    <div class="card-footer d-flex gap-2 flex-wrap">

        @if (User.IsInRole("Admin") || (User.IsInRole("Broker") && Model.OwnerId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary">
                Редакция
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                Изтриване
            </a>
        }

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            Назад
        </a>

    </div>

</div>

@section Scripts {
    <script src="~/js/property-details-favorite.js" asp-append-version="true"></script>
}
