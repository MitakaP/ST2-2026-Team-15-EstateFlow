@model IReadOnlyList<EstateFlow.Models.Property>
@{ ViewData["Title"] = "Моите имоти"; }
<div class="page-heading animate-in"><div><p class="eyebrow">Твоите обяви</p><h1>Моите имоти</h1><p class="text-muted small mt-2 mb-0">Управлявай обявите и представи всеки имот по най-добрия начин.</p></div><a asp-action="Create" class="btn btn-primary"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#plus" /></svg>Добави имот</a></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#building" /></svg><h2>Първата ти обява те очаква</h2><p>Добави основна снимка, описание и детайли за имота.</p><a asp-action="Create" class="btn btn-primary">Създай обява</a></div>
}
else
{
    <div class="property-grid">@foreach (var property in Model) { <partial name="_PropertyCard" model="property" /> }</div>
}
