@model IReadOnlyList<EstateFlow.Models.Property>
@{
    ViewData["Title"] = "Любими имоти";
    ViewData["IsFavoritesPage"] = true;
}
<div class="page-heading animate-in"><div><p class="eyebrow">Запазени за теб</p><h1>Любими имоти</h1><p class="text-muted small mt-2 mb-0">Твоят личен избор, на едно място.</p></div><a class="btn btn-outline-primary" asp-controller="Properties" asp-action="Index">Разгледай обявите</a></div>
@if (Model.Count == 0)
{
    <div class="empty-state"><svg class="icon" aria-hidden="true"><use href="/images/icons.svg#heart" /></svg><h2>Тук започва твоят избор</h2><p>Натисни сърцето на обява, за да я запазиш сред любимите си имоти.</p><a class="btn btn-primary" asp-controller="Properties" asp-action="Index">Открий имот</a></div>
}
else
{
    <div class="property-grid">@foreach (var property in Model) { <partial name="_PropertyCard" model="property" /> }</div>
}
